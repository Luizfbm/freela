{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Paperclip Message QA Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "review_date",
    "queue_date",
    "source",
    "reviews"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "review_date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "queue_date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "reviews": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "lead_name",
          "status_qa",
          "problema",
          "trecho",
          "ajuste_recomendado",
          "decisao"
        ],
        "properties": {
          "lead_name": {
            "type": "string",
            "minLength": 1
          },
          "status_qa": {
            "type": "string",
            "enum": [
              "aprovado_para_lead_cards",
              "aprovado_com_observacao",
              "requer_ajuste",
              "bloqueado"
            ]
          },
          "problema": {
            "type": "string"
          },
          "trecho": {
            "type": "string"
          },
          "ajuste_recomendado": {
            "type": "string"
          },
          "decisao": {
            "type": "string"
          }
        }
      }
    }
  }
}
